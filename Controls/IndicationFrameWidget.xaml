<UserControl x:Class="TemporalMotionExtractionAnalysis.Controls.IndicationFrameWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TemporalMotionExtractionAnalysis.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="220" d:DesignWidth="250">
    <Grid>
        <DockPanel Background="White">
            <TextBlock DockPanel.Dock="Top" Text="Indication Frame" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <Image Source="{Binding IndicationImage.ImagePath}" Height="Auto" Width="230" VerticalAlignment="Center" Margin="0,5,0,0"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Frame Number:" FontWeight="Bold" />
                    <TextBlock Text="{Binding IndicationImage.FrameNumber}" VerticalAlignment="Center" Margin="0"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
